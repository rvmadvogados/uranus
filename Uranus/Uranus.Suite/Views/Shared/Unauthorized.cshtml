@{
    ViewBag.Title = "Acesso Negado";
}

<div class="main_container">
    <div role="main">
        <div class="row">
            <div class="col-md-8 col-md-offset-2">
                <div class="x_panel">
                    <div class="x_content" style="text-align: center; padding: 50px;">
                        <i class="fa fa-exclamation-triangle" style="font-size: 80px; color: #e74c3c; margin-bottom: 20px;"></i>
                        <h2 style="color: #e74c3c; margin-bottom: 20px;">Acesso Negado</h2>
                        <p style="font-size: 16px; margin-bottom: 30px;">
                            Você não possui permissão para acessar esta funcionalidade.
                        </p>
                        <p style="color: #7f8c8d; margin-bottom: 30px;">
                            Entre em contato com o administrador do sistema se você acredita que deveria ter acesso a esta área.
                        </p>
                        <div>
                            <a href="javascript:history.back()" class="btn btn-primary">
                                <i class="fa fa-arrow-left"></i> Voltar
                            </a>
                            @*<a href="~/Dashboard" class="btn btn-default" style="margin-left: 10px;">
                                <i class="fa fa-home"></i> Início
                            </a>*@
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .x_panel {
        border: 1px solid #e74c3c;
        box-shadow: 0 4px 8px rgba(231, 76, 60, 0.1);
    }
    
    .btn {
        min-width: 120px;
    }
</style>
