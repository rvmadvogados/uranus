@{
    ViewBag.Title = "Agendas";
}

<style>
    .fc-event .fc-content {
        white-space: normal;
        overflow: visible;
    }
    .fc-event .fc-title {
        white-space: normal;
    }
    .fc-event {
        border-width: 3px !important;
        border-style: solid !important;
    }
    .fc-right .fc-button-group .fc-button + .fc-button {
        margin-left: 4px !important;
        border-radius: 3px !important;
    }
    .fc-right .fc-button-group .fc-button:first-child {
        border-radius: 3px !important;
    }
    .fc-agendaWeek-button {
        transition: background-color 0.35s ease, border-color 0.35s ease, color 0.35s ease !important;
    }
    .fc-agendaWeek-button.vertical-active {
        background-color: #1ABB9C !important;
        border-color: #17a589 !important;
        color: #fff !important;
    }

    .fc-month-button,
    .fc-agendaWeek-button,
    .fc-agendaDay-button {
        transition: background-color 0.35s ease, border-color 0.35s ease, color 0.35s ease !important;
    }
    .fc-month-button.view-active,
    .fc-agendaWeek-button.view-active,
    .fc-agendaDay-button.view-active {
        background-color: #1ABB9C !important;
        border-color: #17a589 !important;
        color: #fff !important;
    }
    /* Semana Vertical */
    .vw-day-section { margin-bottom: 10px; }
    .vw-day-header {
        background: #f5f5f5;
        padding: 8px 14px;
        font-weight: 600;
        font-size: 13px;
        border-left: 4px solid #1ABB9C;
        color: #333;
    }
    .vw-event-item {
        display: flex;
        align-items: center;
        padding: 7px 14px;
        border-bottom: 1px solid #f0f0f0;
        cursor: pointer;
        transition: background 0.15s;
    }
    .vw-event-item:hover { background: #f9f9f9; }
    .vw-event-item.ausente { color: #c0392b; font-weight: 600; }
    .vw-event-time { font-weight: 700; min-width: 55px; color: #555; flex-shrink: 0; }
    .vw-event-bar { width: 4px; min-height: 18px; border-radius: 2px; margin-right: 10px; flex-shrink: 0; align-self: stretch; }
    .vw-event-title { flex: 1; }
    .vw-empty { padding: 7px 14px; color: #aaa; font-style: italic; font-size: 12px; }
    #CopiarNomeCliente {
        color: #1ABB9C;
        cursor: pointer;
        transition: opacity 0.15s ease, color 0.15s ease;
    }
    #CopiarNomeCliente.disabled {
        color: #ccc;
        opacity: 0.6;
        cursor: not-allowed;
        pointer-events: none;
    }
</style>

