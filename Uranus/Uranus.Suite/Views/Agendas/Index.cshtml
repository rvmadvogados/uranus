                $.ajax({
                    url: "/Agendas/Salvar",
                    type: "POST",
                    data: dados,
                    contentType: false,
                    processData: false,
                    complete: function (data) {
                        $('#ButtonSaveEvent').prop('disabled', false).html('Salvar');
                        var json = $.parseJSON(data.responseText);
                        if (json.codigo == '00') {
                            loadVerticalWeekEvents();
                            $('.antoclose').click();
                        } else if (json.codigo == '-90') {
                            $('#agenda-profissional-alert-error').show();
                        } else if (json.codigo == '-80') {
                            $('#agenda-sede-alert-error').show();
                        } else if (json.codigo == '-70') {
                            $('#agenda-diversos-alert-error').show();
                        } else if (json.codigo == '-60') {
                            $('#agenda-pagamentos-alert-error').show();
                        }
                    }
                });
                $('#ButtonSaveEvent').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Salvando...');
            } else {
                return false;
            }
        });
    }

</script>

