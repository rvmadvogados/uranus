    var my_hour_format = function (input) {

        var d = new Date(input);
        var hour = d.getHours() + 3;
        if (hour < 10) {
            hour = "0" + hour;
        }
        var minute = d.getMinutes();
        if (minute < 10) {
            minute = "0" + minute;
        }

        var hours = hour + ":" + minute;

        return hours;

    };

