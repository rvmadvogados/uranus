        $.ajax({
            url: "/Agendas/Consultar",
            type: "POST",
            data: dados,
            contentType: false,
            processData: false,
            complete: function (data) {
                var json = $.parseJSON(data.responseText);
                if (json.codigo == '00') {
                    var a = json.agenda[0];
                    CarregarProfissionais(a.Data, function () {
                        $('#Profissional').val(a.IdProfissional).trigger('change');
                    });
                    encaixeOriginal = a.Encaixe || "N";
                    $('#Data').val(a.Data);
                    $('#Hora').empty().append($('<option selected></option>').val(a.Hora).html(a.Hora));
                    $('#Hora').prop("disabled", true);
                    if (a.Encaixe == "S") {
                        $("#Encaixe").prop("checked", true);
                    } else {
                        $('#Encaixe').prop("disabled", false);
                        $("#Encaixe").prop("checked", false);
                        $("#EncaixeCSS").removeClass("disabled");
                    }
                    $('#Compareceu').prop("disabled", false);
                    $("#CompareceuCSS").removeClass("disabled");
                    $("#Compareceu").prop("checked", a.Compareceu == "S");
                    $('#Cancelou').prop("disabled", false);
