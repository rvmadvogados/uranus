<script>
    var verticalWeekStart = null;

    function toggleVerticalWeekView() {
        var isVisible = $('#vertical-week-view').is(':visible');
        if (!isVisible) {
            $('#calendar').fullCalendar('changeView', 'agendaWeek');
            verticalWeekStart = $('#calendar').fullCalendar('getDate').clone().startOf('isoWeek');
            $('.fc-view-container').hide();
            $('#vertical-week-view').show();
            $('.fc-agendaWeek-button').addClass('vertical-active');
            loadVerticalWeekEvents();
        } else {
            $('#vertical-week-view').hide();
            $('.fc-view-container').show();
            $('.fc-agendaWeek-button').removeClass('vertical-active');
        }
    }

    function loadVerticalWeekEvents() {
        var start = verticalWeekStart;
        var end = start.clone().add(4, 'days');
        $('#vw-week-title').text(start.format('DD/MM/YYYY') + ' – ' + end.format('DD/MM/YYYY'));
        $('#vw-content').html('<p style="padding:15px;"><i class="fa fa-spinner fa-spin"></i> Carregando...</p>');

        var dados = new window.FormData();
        dados.append("DataInicial", start.format("DD/MM/YYYY"));
        dados.append("DataFinal", end.format("DD/MM/YYYY"));
        if (filtroAtivo.IdSede) dados.append("IdSede", filtroAtivo.IdSede);
        if (filtroAtivo.IdProfissional) dados.append("IdProfissional", filtroAtivo.IdProfissional);
        if (filtroAtivo.IdTipo) dados.append("IdTipo", filtroAtivo.IdTipo);
        if (filtroAtivo.IdCliente) dados.append("IdCliente", filtroAtivo.IdCliente);

        $.ajax({
            url: "/Agendas/Eventos",
            type: "POST",
            data: dados,
            contentType: false,
            processData: false,
            complete: function (data) {
                var eventos = $.parseJSON(data.responseText) || [];
                renderVerticalWeek(eventos);
            }
        });
    }

    function renderVerticalWeek(eventos) {
        var dayNames = ['Segunda', 'Terça', 'Quarta', 'Quinta', 'Sexta'];
        var html = '';
        for (var i = 0; i < 5; i++) {
            var day = verticalWeekStart.clone().add(i, 'days');
            var dayKey = day.format('YYYY-MM-DD');
            var dayEvents = eventos.filter(function (e) {
                return moment(e.start).format('YYYY-MM-DD') === dayKey;
            }).sort(function (a, b) {
                return moment(a.start).valueOf() - moment(b.start).valueOf();
            });

            html += '<div class="vw-day-section">';
            html += '<div class="vw-day-header">' + dayNames[i] + ', ' + day.format('DD/MM/YYYY') + '</div>';
            if (dayEvents.length === 0) {
                html += '<div class="vw-empty">Sem agendamentos</div>';
            } else {
                dayEvents.forEach(function (e) {
                    var time = moment(e.start).format('HH:mm');
                    var color = e.color || '#3a87ad';
                    var ausenteClass = (e.compareceu === "False") ? ' ausente' : '';
                    html += '<div class="vw-event-item' + ausenteClass + '" onclick="verticalWeekEventClick(' + e.id + ')">';
                    html += '<span class="vw-event-time">' + time + '</span>';
                    html += '<span class="vw-event-bar" style="background:' + color + ';"></span>';
                    html += '<span class="vw-event-title">' + (e.title || '') + '</span>';
                    html += '</div>';
                });
            }
            html += '</div>';
        }
        $('#vw-content').html(html);
    }

    function verticalWeekEventClick(agendaId) {
        $('#agenda-profissional-alert-error').hide();
        $('#agenda-sede-alert-error').hide();
        $('#agenda-diversos-alert-error').hide();
        $('#agenda-pagamentos-alert-error').hide();

        $('#id').val(agendaId);
