            events: function (start, end, tz, callback) {
                NProgress.start();
                $('#calendar-loading').show();
                var dados = new window.FormData();

                //// Usa datas do filtro manual se informadas, senão usa o range visível
                //var dataIni = (filtroAtivo.DataInicial && filtroAtivo.DataInicial.length > 0)
                //    ? filtroAtivo.DataInicial
                //    : start.format("DD/MM/YYYY");
                //var dataFim = (filtroAtivo.DataFinal && filtroAtivo.DataFinal.length > 0)
                //    ? filtroAtivo.DataFinal
                //    : end.format("DD/MM/YYYY");

                var dataIni = start.format("DD/MM/YYYY");
                var dataFim = end.format("DD/MM/YYYY");

                dados.append("DataInicial", dataIni);
                dados.append("DataFinal", dataFim);

                if (filtroAtivo.IdSede) dados.append("IdSede", filtroAtivo.IdSede);
                if (filtroAtivo.IdProfissional) dados.append("IdProfissional", filtroAtivo.IdProfissional);
                if (filtroAtivo.IdTipo) dados.append("IdTipo", filtroAtivo.IdTipo);
                if (filtroAtivo.IdCliente) dados.append("IdCliente", filtroAtivo.IdCliente);

                $.ajax({
                    url: "/Agendas/Eventos",
                    type: "POST",
                    data: dados,
                    contentType: false,
                    processData: false,
                    complete: function (data) {
                        NProgress.done();
                        $('#calendar-loading').hide();

                        var eventos = $.parseJSON(data.responseText) || [];

                        eventos.sort(function (a, b) {
                            var endA = a.end ? moment(a.end) : moment(a.start);
                            var endB = b.end ? moment(b.end) : moment(b.start);

                            if (endA.isBefore(endB)) return 1;
                            if (endA.isAfter(endB)) return -1;

                            var startA = moment(a.start);
                            var startB = moment(b.start);

                            if (startA.isBefore(startB)) return 1;
                            if (startA.isAfter(startB)) return -1;

                            return (b.id || 0) - (a.id || 0);
                        });

                        callback(eventos);
                    }
                    
                });
            },
            dayRender: function (date, cell, view) {

                var dateAux = date.toISOString().match(/^[0-9]{4}\-[0-9]{2}\-[0-9]{2}/)[0].split('-').reverse().join('/');

                if (feriados.indexOf(dateAux) > 0) {

                    var titulo = feriados.substring(feriados.indexOf(dateAux) + 13);
                    titulo = titulo.substring(0, titulo.indexOf(';'));
                    $(cell).text('‣ ' + titulo);
                    $(cell).css({ "background-color": "#FFC2C2" });

                }

            },
