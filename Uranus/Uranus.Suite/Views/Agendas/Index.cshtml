                    if (a.Valor != null) {
                        $('#Valor').val(a.Valor == 0 ? 'R$ 0,00' : 'R$ ' + mascaraValor(a.Valor.toFixed(2)));
                    }
                    if (a.IdCliente != null && $.isNumeric(a.IdCliente)) {
                        choicesCliente.removeActiveItems();
                        choicesCliente.clearChoices();
                        choicesCliente.setChoices(
                            [{ value: a.IdCliente.toString(), label: a.Cliente, selected: true, disabled: false }],
                            'value', 'label', false
                        );
                        choicesCliente.setChoiceByValue(a.IdCliente.toString());
                    } else {
                        choicesCliente.removeActiveItems();
                        choicesCliente.clearChoices();
                    }
                    if (a.Telefone != null) $('#Telefone').val(a.Telefone);
                    $('#Descricao').val(a.Descricao);
                    CarregarSalas(a.IdSede, a.IdSala);
                    $('#TipoIndicacao').val(a.TipoIndicacao);
                    $('#NomeIndicacao').val(a.Indicacao);
                    $('#Parceiros').val(a.Parceiro);
                    $('#Profissionais').val(a.Profissional);
                    $('#DataCadastro').val(a.DataCadastro);
                    $('#UsuarioCadastro').val(a.UsuarioCadastro);
                    $('#DataAlteracao').val(a.DataAlteracao);
                    $('#UsuarioAlteracao').val(a.UsuarioAlteracao);
                    $('#FormaPagamento').val(a.IdFormaPagamento);
                    $('#Banco').val(a.IdBanco);
                    $('#IdArea').val(a.IdArea);
                    $('#idReceita').val(a.IdReceita);
                    ShowIndicacao(a.Tipo);
                    if ($('#Compareceu').prop('checked') || $('#Cancelou').prop('checked')) {
                        $('#DescriptionRequired').removeClass('hidden');
                        $('#Descricao').attr('data-rule-required', 'true');
                        if ($('#Descricao').val().length == 0) {
                            $('#DescriptionError').removeClass('hidden').css('display', 'block');
                        } else {
                            $('#DescriptionError').addClass('hidden').css('display', 'none');
                        }
                    } else {
                        $('#DescriptionRequired').addClass('hidden');
                        $('#DescriptionError').addClass('hidden').css('display', 'none');
                        $('#Descricao').removeAttr('data-rule-required');
                    }
                }
            }
        });

        $('#CalenderModal').modal('show');

        $('.antosubmit').off('click');
        $(".antosubmit").on("click", function () {
            var valid = true;
            if (($('#Cancelou').prop('checked') || $('#Compareceu').prop('checked')) && $('#Descricao').val().length == 0) {
                $('#DescriptionError').css('display', 'block').show();
                valid = false;
            }
            $("#antoform").validate();
            if ($('#antoform').valid() && valid) {
                switch ($("#Assunto").val()) {
                    case "1": case "3": case "6": case "9": case "10": case "12": case "16": case "17": case "18":
                        if ($('#Cliente option:selected').val() == null || !$.isNumeric($('#Cliente option:selected').val())) {
                            $('#ClienteValidate').removeClass('hidden').css("display", "");
                            return false;
                        } else {
                            $('#ClienteValidate').addClass('hidden');
