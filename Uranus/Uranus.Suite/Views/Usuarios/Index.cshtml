                if (email && email !== "undefined") {
                    dados.append("Email", email.trim());
                } else {
                    // Enviar string vazia para indicar que o e-mail deve ser removido
                    dados.append("Email", "");
                }

                var options = {};
                options.url = "/Usuarios/Salvar"
                options.type = "POST";
                options.data = dados;
                options.asyn = true;
                options.contentType = false;
                options.processData = false;
                options.dataType = "application/json; charset=utf-8";
                options.complete = function (data) {
                    var json = $.parseJSON(data.responseText);
                    if (json.codigo == '00') {
                        dadosForamSalvos = true;

                        $('#modalMensagemResposta').text(json.mensagem || 'Usuário salvo com sucesso!');
                        $('#modalMensagem').modal('show');
                        $("#usuario-form").validate().resetForm();
                    } else if (json.codigo == '96') {

                        dadosForamSalvos = true;

                        $('#modalMensagemResposta').text(json.mensagem);
                        $('#modalMensagem').modal('show');
                        $("#usuario-form").validate().resetForm();
                    } else if (json.codigo == '95') {

                        dadosForamSalvos = false;

                        $('#modalMensagemResposta').text('⚠️ ' + json.mensagem);
                        $('#modalMensagem').modal('show');
                    } else {
                        $('#modalMensagemResposta').text('Erro ao salvar: ' + (json.mensagem || 'Erro desconhecido'));
                        $('#modalMensagem').modal('show');
                    }
                };
                $.ajax(options);

                evt.preventDefault();
            }
            else {
                return false;
            }
        });

