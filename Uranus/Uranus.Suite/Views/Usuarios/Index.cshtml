        // Função para carregar e-mail do Identity
        function CarregarEmailUsuario(login) {
            if (!login) {
                $('#Email').val('');
                return;
            }

            $.ajax({
                url: '/Usuarios/ConsultarEmail',
                type: 'POST',
                data: JSON.stringify({ login: login }),
                contentType: 'application/json',
                success: function (result) {
                    if (result.codigo === "00") {
                        $('#Email').val(result.email || '');

                        // Atualizar indicador de confirmação se necessário
                        if (result.emailConfirmed) {
                            $('#Email').css('border-color', '#26B99A');
                        } else if (result.email) {
                            $('#Email').css('border-color', '#F39C12');
                        } else {
                            $('#Email').css('border-color', '');
                        }
                    } else {
                        console.error('Erro ao carregar e-mail:', result.mensagem);
                        $('#Email').val('');
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Erro ao carregar e-mail:', error);
                    $('#Email').val('');
                }
            });
        }

        // Wrapper para manter compatibilidade com o botão da grid
        function ConsultarStatus2FA(login) {

            $.ajax({
                url: '/Usuarios/Listar',
                type: 'POST',
                success: function (result) {
                    if (result.codigo === "00" && result.usuarios) {
                        var usuario = result.usuarios.find(function (u) {
                            return u.Login === login;
                        });

                        if (usuario) {
                            Visualizar(usuario.ID);
                            setTimeout(function () {
                                VerStatus2FA();
                            }, 500);
                        } else {
                            alert('Usuário não encontrado');
                        }
                    }
                },
                error: function () {
                    // Fallback: mostrar modal direto
                    usuario2FAAtual = login;
                    $('#status2FA-usuario').text(login);
                    $('#status2FA-enabled').html('<i class="fa fa-spinner fa-spin"></i> Carregando...');
                    $('#status2FA-authenticator').html('<i class="fa fa-spinner fa-spin"></i> Carregando...');
                    $('#status2FA-recovery').html('<i class="fa fa-spinner fa-spin"></i> Carregando...');
                    $('#modalStatus2FA').modal('show');

                    $.ajax({
                        url: '/Usuarios/ConsultarStatus2FA',
                        type: 'POST',
                        data: JSON.stringify({ login: login }),
                        contentType: 'application/json',
                        success: function (result) {
                            if (result.codigo === "00") {
                                if (result.twoFactorEnabled) {
                                    $('#status2FA-enabled').html('<i class="fa fa-check-circle" style="color: #26B99A;"></i> <strong style="color: #26B99A;">Habilitado</strong>');
                                } else {
                                    $('#status2FA-enabled').html('<i class="fa fa-times-circle" style="color: #E74C3C;"></i> <strong style="color: #E74C3C;">Desativado</strong>');
                                }

                                if (result.hasAuthenticator) {
                                    $('#status2FA-authenticator').html('<i class="fa fa-check-circle" style="color: #26B99A;"></i> <strong style="color: #26B99A;">Sim</strong>');
                                } else {
                                    $('#status2FA-authenticator').html('<i class="fa fa-times-circle" style="color: #E74C3C;"></i> <strong style="color: #E74C3C;">Não</strong>');
                                }

                                var recoveryCount = result.recoveryCodesRemaining || 0;
                                var recoveryColor = recoveryCount > 5 ? '#26B99A' : (recoveryCount > 0 ? '#F39C12' : '#E74C3C');
                                var recoveryIcon = recoveryCount > 5 ? 'check-circle' : (recoveryCount > 0 ? 'exclamation-triangle' : 'times-circle');

                                $('#status2FA-recovery').html(
                                    '<i class="fa fa-' + recoveryIcon + '" style="color: ' + recoveryColor + ';"></i> ' +
                                    '<strong style="color: ' + recoveryColor + ';">' + recoveryCount + ' código(s)</strong>'
                                );
                            }
                        }
                    });
                }
            });
        }

        function Ativar2FA(login) {
            if (!confirm('Deseja ativar o 2FA para o usuário ' + login + '?\n\n' +
                'Se o usuário já tinha configuração anterior, ela será reativada.\n' +
                'Se não tinha, será obrigado a configurar no próximo login.')) {
                return;
            }

            $.ajax({
                url: '/Usuarios/Ativar2FA',
                type: 'POST',
                data: JSON.stringify({ login: login }),
                contentType: 'application/json',
                success: function (result) {
                    if (result.codigo === "00") {
                        alert('✅ ' + result.mensagem);

                        if (result.detalhes && result.detalhes.requiresSetup) {
                            alert('⚠️ Usuário precisará configurar o Google Authenticator no próximo login ou por e-mail.');
                        } else if (result.detalhes && result.detalhes.hasAuthenticator) {
                            alert('ℹ️ Configuração anterior reativada. Usuário pode usar o mesmo Google Authenticator.');
                        }
                        setTimeout(function () {
                            AtualizarBotoes2FA(login);
                        }, 500); // Aguarda meio segundo antes de atualizar os botões
                    } else if (result.codigo === "97") {
                        // Erro detalhado da API
                        var errorMsg = '❌ Erro ao ativar 2FA\n\n';
                        errorMsg += 'Mensagem: ' + (result.mensagem || 'Erro desconhecido') + '\n';
                        if (result.statusCode) {
                            errorMsg += 'Status HTTP: ' + result.statusCode + '\n';
                        }
                        if (result.detalhes) {
                            errorMsg += '\nDetalhes:\n' + result.detalhes;
                        }
                        alert(errorMsg);
                        console.error('Erro ao ativar 2FA:', result);
                    } else {
                        alert('❌ ' + (result.mensagem || 'Erro ao ativar 2FA'));
                        console.error('Erro ao ativar 2FA:', result);
                    }
                },
                error: function (xhr, status, error) {
                    var errorMsg = '❌ Erro na requisição para ativar 2FA\n\n';
                    errorMsg += 'Status: ' + xhr.status + '\n';
                    errorMsg += 'Erro: ' + error + '\n';
                    if (xhr.responseText) {
                        errorMsg += '\nResposta:\n' + xhr.responseText;
                    }
                    alert(errorMsg);
                    console.error('Erro na requisição:', xhr);
                }
            });
        }

        function Desativar2FA(login) {
            if (!confirm('Deseja desativar o 2FA para o usuário ' + login + '?\n\n' +
                'A configuração será preservada e pode ser reativada depois sem precisa reconfigurar.')) {
                return;
            }

            $.ajax({
                url: '/Usuarios/Desativar2FA',
                type: 'POST',
                data: JSON.stringify({ login: login }),
                contentType: 'application/json',
                success: function (result) {
                    if (result.codigo === "00") {
                        alert('✅ ' + result.mensagem);

                        if (result.detalhes && result.detalhes.canReactivate) {
                            alert('ℹ️ Você pode reativar o 2FA depois sem precisar reconfigurar.');
                        }
                        setTimeout(function () {
                            AtualizarBotoes2FA(login);
                        }, 500); // Aguarda meio segundo antes de atualizar os botões
                    } else {
                        alert('❌ ' + (result.mensagem || 'Erro ao desativar 2FA'));
                    }
                },
                error: function (xhr, status, error) {
                    alert('❌ Erro ao desativar 2FA: ' + error);
                }
            });
        }

