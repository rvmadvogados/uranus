@{
    ViewBag.Title = "Cadastros Sistêmicos \\\\ Usuários";
}

<script>
    window.AuthApiUrl = '@ViewBag.AuthApiUrl';
    window.AuthToken = '@ViewBag.Token';

    function randomPassword() {
        var requiredLength = 10;
        var lower = "abcdefghijklmnopqrstuvwxyz";
        var upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        var digits = "0123456789";
        var symbols = "!@@#$%^&*()-+<>";
        var all = lower + upper + digits + symbols;

        var pw = [];

        pw.push(lower.charAt(Math.floor(Math.random() * lower.length)));
        pw.push(upper.charAt(Math.floor(Math.random() * upper.length)));
        pw.push(digits.charAt(Math.floor(Math.random() * digits.length)));
        pw.push(symbols.charAt(Math.floor(Math.random() * symbols.length)));

        for (var i = pw.length; i < requiredLength; i++) {
            pw.push(all.charAt(Math.floor(Math.random() * all.length)));
        }

        for (var i = pw.length - 1; i > 0; i--) {
            var j = Math.floor(Math.random() * (i + 1));
            var tmp = pw[i]; pw[i] = pw[j]; pw[j] = tmp;
        }

        return pw.join('');
    }
</script>

