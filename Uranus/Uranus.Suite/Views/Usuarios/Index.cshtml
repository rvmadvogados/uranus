                if (senhaValue && senhaValue !== "undefined" && senhaValue.trim() !== "") {
                    dados.append("Senha", senhaValue);
                } else {
                    dados.append("Senha", ""); // Enviar string vazia ao invés de undefined
                }

                dados.append("Ativo", $("input[type='radio'][name='Ativo']:checked").val());
