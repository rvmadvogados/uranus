        function AtualizarTempoRestanteBloqueio(dataHoraUltimoBloqueio) {
            if (!dataHoraUltimoBloqueio) return;

            var bloqueioAte = new Date(dataHoraUltimoBloqueio);
            var duracao = 15 * 60 * 1000; // 15 minutos em milissegundos
            bloqueioAte = new Date(bloqueioAte.getTime() + duracao);

            var interval = setInterval(function () {
                var agora = new Date();
                var diferenca = bloqueioAte - agora;

                if (diferenca > 0) {
                    var minutos = Math.floor(diferenca / 60000);
                    var segundos = Math.floor((diferenca % 60000) / 1000);
                    $('#tempo-restante').text(minutos + 'm ' + segundos + 's');
                } else {
                    $('#tempo-restante').text('0m 0s');
                    clearInterval(interval);
                }
            }, 1000);
        }

    </script>
