        // ===== Funções para Gerenciamento de Bloqueio (Lockout) =====

        function DesbloquearDaGrid(Id, login) {
            if (!login || login.trim() === "") {
                alert('❌ Login do usuário não foi encontrado');
                return;
            }

            if (!confirm('Deseja desbloquear o usuário ' + login + '?\n\nEle poderá fazer login normalmente após o desbloqueio.')) {
                return;
            }

            // Desabilitar o botão durante a requisição
            var btn = event.target;
            if (btn) $(btn).prop('disabled', true);

            $.ajax({
                url: '/Usuarios/DesbloqueaUsuario',
                type: 'POST',
                data: JSON.stringify({ login: login.trim() }),
                contentType: 'application/json',
                dataType: 'json',
                timeout: 30000,
                success: function (result) {
                    if (result && result.codigo === "00") {
                        alert('✅ ' + (result.mensagem || 'Usuário desbloqueado com sucesso!'));
                        setTimeout(function () {
                            Atualizar();
                        }, 1000);
                    } else if (result && result.codigo === "97") {
                        var errorDetail = result.erro || 'Erro desconhecido ao desbloquear';
                        var statusInfo = result.statusCode ? ` (Status: ${result.statusCode})` : '';
                        alert('❌ Erro ao desbloquear:\n\n' + errorDetail + statusInfo);
                    } else {
                        alert('❌ ' + (result ? result.mensagem : 'Erro desconhecido ao desbloquear'));
                    }
                },
                error: function (xhr, status, error) {

                    var mensagemErro = 'Erro ao desbloquear usuário';
                    if (status === 'timeout') {
                        mensagemErro = 'Timeout: A requisição demorou muito tempo';
                    } else if (xhr.status === 404) {
                        mensagemErro = 'Erro 404: Endpoint não encontrado';
                    } else if (xhr.status === 500) {
                        mensagemErro = 'Erro 500: Erro no servidor';
                    } else if (xhr.status === 401) {
                        mensagemErro = 'Erro 401: Não autorizado - Verifique seu token/permissões';
                    } else if (xhr.status === 0) {
                        mensagemErro = 'Erro de conexão: Verifique se a API está disponível';
                    }

                    alert('❌ ' + mensagemErro + '\n\nDetalhes: ' + error);
                },
                complete: function () {
                    // Reabilitar o botão
                    if (btn) $(btn).prop('disabled', false);
                }
            });
        }

        function CarregarStatusBloqueio(login) {
            if (!login) {
                $('#secaoBloqueio').hide();
                return;
            }

            $.ajax({
                url: '/Usuarios/ConsultarBloqueio',
                type: 'POST',
                data: JSON.stringify({ login: login }),
                contentType: 'application/json',
                success: function (result) {
                    if (result.codigo === "00") {
                        if (result.estaBloqueado) {
                            // Usuário está bloqueado
                            $('#statusBloqueio-status').html('<i class="fa fa-lock" style="color: #E74C3C;"></i> <strong style="color: #E74C3C;">BLOQUEADO</strong>');
                            $('#statusBloqueio-attempts').html('<strong style="color: #E74C3C;">' + (result.tentativasRestantes || 0) + '</strong>');
                            $('#bloqueio-info').show();
                            $('#btnDesbloquearUsuario').prop('disabled', false);

                            // Calcular tempo restante
                            var bloqueioAte = new Date(result.bloqueioAte);
                            var agora = new Date();
                            var diferenca = bloqueioAte - agora;

                            if (diferenca > 0) {
                                var minutos = Math.floor(diferenca / 60000);
                                var segundos = Math.floor((diferenca % 60000) / 1000);
                                $('#tempo-restante').text(minutos + 'm ' + segundos + 's');
                            }
                        } else {
                            // Usuário não está bloqueado
                            $('#statusBloqueio-status').html('<i class="fa fa-check-circle" style="color: #26B99A;"></i> <strong style="color: #26B99A;">Desbloqueado</strong>');
                            $('#statusBloqueio-attempts').html('<strong style="color: #26B99A;">0</strong>');
                            $('#bloqueio-info').hide();
                            $('#btnDesbloquearUsuario').prop('disabled', true);
                        }
                    } else {
                        $('#secaoBloqueio').hide();
                    }
                },
                error: function (xhr, status, error) {
                    $('#secaoBloqueio').hide();
                }
            });
        }

        $('#btnDesbloquearUsuario').click(function () {
            var login = $('#Usuario').val();

            if (!login) {
                alert('Usuário não identificado');
                return;
            }

            if (!confirm('Deseja desbloquear o usuário ' + login + '?\n\nEle poderá fazer login normalmente após o desbloqueio.')) {
                return;
            }

            $.ajax({
                url: '/Usuarios/DesbloqueaUsuario',
                type: 'POST',
                data: JSON.stringify({ login: login }),
                contentType: 'application/json',
                success: function (result) {
                    if (result.codigo === "00") {
                        alert('✅ ' + result.mensagem);
                        CarregarStatusBloqueio(login);
                    } else {
                        alert('❌ ' + (result.mensagem || 'Erro ao desbloquear usuário'));
                    }
                },
                error: function (xhr, status, error) {
                    alert('❌ Erro ao desbloquear usuário: ' + error);
                }
            });
        });

