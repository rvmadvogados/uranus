    <div role="main">
        <div class="">
            <div class="row">
                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div>
                        @{ WebGrid grid = new WebGrid(Model); }
                        <div class="row">
                            <div class="col-md-12 col-sm-12 col-xs-12">
                                <div class="x_panel">
                                    <div class="x_title">
                                        <h2>Criar e Filtrar Usuários</h2>
                                        <ul class="right panel_toolbox" style="list-style: none;">
                                            <li>
                                                <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                                            </li>
                                        </ul>
                                        <div class="clearfix"></div>
                                    </div>
                                    <div class="x_content">
                                        <div class="row">
                                            <div class="col-md-7">
                                                <div class="form-group">
                                                    <button type="button" class="btn btn-success" data-toggle="modal" data-target="#modalNovo" style="margin-top: 25px !important;" onclick="Novo();">Novo</button>
                                                </div>
                                            </div>
                                            @using (Html.BeginForm("Index", "Usuarios", FormMethod.Get, null))
                                            {
                                                <div class="col-md-3">
                                                    <div class="form-group">
                                                        <label class="titlefield">Procura na Coluna Nome</label>
                                                        <input id="search" name="search" type="search" class="form-control" placeholder="Informe o Nome" value="@ViewBag.search" style="border: 1px solid #CCCCCC !important;" />
                                                    </div>
                                                </div>
                                                <div class="col-md-2">
                                                    <div class="form-group" style="vertical-align: bottom !important;">
                                                        <button type="submit" class="btn btn-primary" style="margin-top: 25px !important;">Filtrar</button>
                                                        &nbsp;
                                                        <button type="submit" class="btn btn-default" style="margin-top: 25px !important;" onclick="$('#search').val('');">Limpar</button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div>
                            @{
                                @grid.GetHtml(
                                          tableStyle: "webgrid",
                                          fillEmptyRows: false,
                                          headerStyle: "webgrid-header",
                                          alternatingRowStyle: "webgrid-alternating-row",
                                          rowStyle: "webgrid-row-style",
                                          selectedRowStyle: "webgrid-selected-row",
                                          footerStyle: "webgrid-footer",
                                          mode: WebGridPagerModes.All,
                                          firstText: "Primeiro",
                                          previousText: "Anterior",
                                          nextText: "Próximo",
                                          lastText: "Último",
                                          numericLinksCount: 5,
                                          columns: new[] {
                                grid.Column("Nome", header: "Nome", style: "width:140px"),
                                grid.Column("Login", header: "Usuário", style: "width:90px"),
                                grid.Column("Email", header: "E-mail 2FA", format: (item) => new HtmlString(
                                    item["Email"] != null && !string.IsNullOrEmpty(item["Email"].ToString())
                                    ? "<span style='color: #2E7D32; text-muted-small'>" + item["Email"] + "</span>"
                                    : "<span class='text-muted-small'>Não informado</span>"
                                ), style: "width:160px"),
                                grid.Column("PerfilDeAcesso", header: "Perfil", style: "width:90px"),
                                grid.Column("LastLoginDate", header: "Último Login", format: (item) => new HtmlString(
                                    item["LastLoginDate"] != null
                                    ? string.Format("<div style='color: #2E7D32; text-muted-small; line-height: 1.3;'><div style='font-weight: 500;'>{0:dd/MM/yyyy HH:mm:ss}</div></div>", item["LastLoginDate"])
                                    : "<span class='text-muted-small'>Nunca logou</span>"
                                ), style: "width:80px; text-align:center"),
                                grid.Column("Bloqueio", header: "Status", format: (item) => new HtmlString(
                                    !(bool)item["Bloqueio"]
                                    ? "<span class='status-active'><i class='fa fa-check-circle'></i> Ativo</span>"
                                    : "<span class='status-inactive'><i class='fa fa-ban'></i> Inativo</span>"
                                ), style: "width:70px; text-align:center"),
                                grid.Column("TwoFactorEnabled", header: "2FA", format: (item) => new HtmlString(
                                    (bool)item["TwoFactorEnabled"]
                                    ? "<span style='color: #28a745; text-muted-small;'><i class='fa fa-shield'></i> Sim</span>"
                                    : "<span class='text-muted-small'><i class='fa fa-shield'></i> Não</span>"
                                ), style: "width:50px; text-align:center"),
                                grid.Column("AccessFailedCount", header: "Falhas", format: (item) => new HtmlString(
                                    item["AccessFailedCount"] != null && (int)item["AccessFailedCount"] > 0
                                    ? "<span style='color: #dc3545; text-muted-small; font-weight: 600;'><i class='fa fa-exclamation-triangle'></i> " + item["AccessFailedCount"] + "</span>"
                                    : "<span style='color: #28a745; text-muted-small;'>0</span>"
                                ), style: "width:50px; text-align:center"),

                                // ✅ NOVA COLUNA: Data Fim Bloqueio
                                grid.Column("DataFimBloqueio", header: "Bloqueado Até", format: (item) => new HtmlString(
                                        item["EstaBloqueado"] != null && (bool)item["EstaBloqueado"]
                                ? "<span style='color: #dc3545; font-weight: 600; text-muted-small;'>" +
                                        (item["DataFimBloqueio"] != null ? string.Format("{0:dd/MM/yyyy HH:mm:ss}", item["DataFimBloqueio"]) : "N/A") +
                        "</span>"
                                : "<span style='color: #28a745; text-muted-small;'>-</span>"
                                  ), style: "width:120px; text-align:center"),

grid.Column("", header: "Bloqueio", canSort:false, format: (item) => new HtmlString(
        (int)item["AccessFailedCount"] > 0 && (bool)item["EstaBloqueado"]
   ? "<div class='action-buttons'><button class='btn btn-danger btn-xs' onclick='DesbloquearDaGrid(" + item.ID + ", \"" + item.Login + "\");'><i class='fa fa-unlock'></i> Desbloquear</button></div>"
      : "<span style='color: #28a745; text-muted-small;'><i class='fa fa-check-circle'></i> OK</span>"
        ), style: "width:100px; text-align:center"),
                                grid.Column("ID", header: "Ações", canSort:false, style: "width:140px; text-align:center",
                                format:
                    @<text>
                        <div class="action-buttons">
                            @Html.Raw("<a class='btn btn-default btn-xs' data-toggle='modal' data-target='#modalNovo' onclick='Visualizar(" + item.ID + ");' title='Visualizar usuário'>Visualizar</a>")
                            @Html.Raw("<a class='btn btn-primary btn-xs' data-toggle='modal' data-target='#modalNovo' onclick='Alterar(" + item.ID + ");' title='Alterar usuário'>Alterar</a>")
                        </div>
                    </text>)
                               });

                                int firstRecord = (grid.PageIndex * grid.RowsPerPage) + 1;
                                int lastRecord = (grid.PageIndex * grid.RowsPerPage) + grid.Rows.Count();

                                var totalRecord = "Nenhuma linha encontrada";

                                if (grid.TotalRowCount == 1)
                                {
                                    totalRecord = "Mostrando " + firstRecord + " a " + lastRecord + " de " + grid.TotalRowCount + " linha";
                                }
                                else if (grid.TotalRowCount > 1)
                                {
                                    totalRecord = "Mostrando " + firstRecord + " a " + lastRecord + " de " + grid.TotalRowCount + " linhas";
                                }

                                <div class="right">@totalRecord</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- /page content -->
    <div id="modalMensagem" class="modal fade" role="dialog" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="Atualizar();"><span aria-hidden="true" style="font-size: 24pt;">&times;</span></button>
                    <h3 class="modal-title"><i class="fa fa-info-circle"></i> Mensagem</h3>
                </div>
                <div class="modal-body">
                    <h4 id="modalMensagemResposta">Operação realizada com sucesso!</h4>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" style="margin: 0;" data-dismiss="modal" onclick="Atualizar();">OK</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Variável de controle para saber se houve salvamento
        var dadosForamSalvos = false;

        $(document).ready(function () {
            // Carregar perfis de acesso via controller ao invés da API diretamente
            $.ajax({
                url: '/Usuarios/ListarPerfisAtivos',
                type: 'GET',
                success: function (data) {
                    var select = $('#PerfilDeAcesso');
                    select.empty();
                    select.append('<option value="">Selecione o Perfil</option>');

                    if (data.codigo === "00" && data.perfis && Array.isArray(data.perfis)) {
                        // A API retorna um array de strings com os nomes dos perfis
                        $.each(data.perfis, function (i, perfilNome) {
                            if (perfilNome && perfilNome.trim() !== '') {
                                select.append('<option value="' + perfilNome + '">' + perfilNome + '</option>');
                            }
                        });
                    } else {
                        console.error('Formato de resposta inválido:', data);
                    }
                },
                error: function (xhr, status, error) {
                    alert('Erro ao carregar perfis de acesso. Por favor, recarregue a página ou contate o administrador.');
                }
            });

            // Quando o modal de usuário for fechado, verificar se precisa recarregar
            $('#modalNovo').on('hidden.bs.modal', function () {
                if (dadosForamSalvos) {
                    // Recarregar a página apenas se dados foram salvos
                    Atualizar();
                    dadosForamSalvos = false; // Resetar flag
                }
            });
        });

        function Novo() {
            $('#modalLabelTitle').text('Novo Usuário');
            $('#Nome').attr('disabled', false);
            $('#Nome').val('');
            $('#Usuario').attr('disabled', false);
            $('#Usuario').val('');
            $('#Email').attr('disabled', false);
            $('#Email').val('');
            $('#Senha').attr('disabled', false);
            $('#Senha').val(randomPassword());
            $('#buttonReciclarSenha').attr('disabled', false);
            $('input[name=Ativo][value="S"]').attr('disabled', false);
            $('input[name=Ativo][value="N"]').attr('disabled', false);
